# Создай локальный файл .env и вставь СЮДА новый токен, полученный через BotFather.
# Не используй значение токена из публичного issue: его нужно перевыпустить.
BOT_TOKEN=

# Локальная Ollama; никакой платный AI API не вызывается.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=180
MAX_IMAGE_MB=15
LOG_LEVEL=INFO
