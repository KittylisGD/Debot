# Telegram Bot API: укажи новый токен, перевыпущенный через BotFather.
BOT_TOKEN=

# qwen (рекомендуется при доступной квоте Singapore) или deepseek.
AI_PROVIDER=qwen

# Alibaba Cloud Model Studio (Qwen).
QWEN_API_KEY=
# Скопируй endpoint из Model Studio. Singapore выглядит так:
# https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
QWEN_MODEL=qwen3-vl-plus
# true только после включения Free Quota Only для этой модели в консоли.
QWEN_FREE_QUOTA_ONLY_CONFIRMED=false
# Если Free Quota Only не используется и ты осознанно разрешаешь оплату — true.
QWEN_ALLOW_PAYG=false

# DeepSeek — тарификация по токенам; вызовы заблокированы, пока false.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_ALLOW_PAID=false

# Глобальный предохранитель для всех пользователей, сброс по UTC.
MAX_API_CALLS_PER_DAY=50
MAX_OUTPUT_TOKENS=512
MAX_INPUT_CHARS=4000
MAX_IMAGE_MB=8
LOG_LEVEL=INFO
